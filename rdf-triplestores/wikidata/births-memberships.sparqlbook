    "value": "SELECT ?person ?personLabel WHERE {\n  ?person wdt:P39 wd:Q18510612.\n  ?person rdfs:label ?personLabel .\n  FILTER(LANG(?personLabel) = \"en\")\n}\nORDER BY ?personLabel\nlimit 10\n",
