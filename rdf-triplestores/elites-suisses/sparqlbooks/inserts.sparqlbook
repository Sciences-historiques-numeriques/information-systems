    "value": "## Create new graph with correct URI \n\n* Create the new graph\n* Check\n* Drop the former one",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "INSERT {\n  GRAPH <https://elites-suisses.lod4hss.org/resource/> {\n    ?s ?p ?o .\n  }\n}\nWHERE {\n  GRAPH <https://elites-suisses.lod4hss.org/data> {\n    ?s ?p ?o .\n  }\n}",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "SELECT (COUNT(*) AS ?count) WHERE {\n  GRAPH <https://elites-suisses.lod4hss.org/resource/> { ?s ?p ?o }\n}",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "SELECT ?g (COUNT(*) as ?num)\nWHERE {\nGRAPH ?g {\n    ?s ?p ?o\n}    \n}\nGROUP BY ?g\nORDER BY DESC(?num)",
    "metadata": {}
  },
