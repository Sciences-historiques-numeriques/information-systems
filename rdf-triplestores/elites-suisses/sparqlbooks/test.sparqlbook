    "value": "SELECT ?p ?pLabel ?o\nWHERE {\n  <https://elites-suisses.lod4hss.org/resource/p55864> ?p ?o .\n  OPTIONAL {\n    ?p rdfs:label ?pLabel .\n  }\n}\nLIMIT 10",
