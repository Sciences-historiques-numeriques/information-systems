    "language": "sparql",
    "value": "PREFIX owl: <http://www.w3.org/2002/07/owl#>\nPREFIX sdh: <https://sdhss.org/ontology/core/>\nPREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>\n\nSELECT *\nWHERE {\n  ?s a sdh:C13 ;\n     <https://sdhss.org/ontology/shortcuts/P9> ?name ;\n     <https://sdhss.org/ontology/shortcuts/P14> ?point ;\n     owl:sameAs ?wikidata .\n}\nlimit 10",
