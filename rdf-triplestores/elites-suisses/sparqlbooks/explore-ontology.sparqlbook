[
  {
    "kind": 2,
    "language": "sparql",
    "value": "SELECT ?class ?classLabel (COUNT(*) as ?num)\nWHERE {\n    ?s a ?class.\n    ?class rdfs:label ?classLabel\n}\nGROUP BY ?class ?classLabel\nORDER BY DESC(?num)",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "prefix crm: <http://www.cidoc-crm.org/cidoc-crm/>\n\nselect ?p ?o\nwhere { \n    crm:E67 ?p ?o\n}",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "prefix crm: <http://www.cidoc-crm.org/cidoc-crm/>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n\nselect ?s ?sLabel ?p\nwhere { \n    ?s ?p crm:E67. \n    OPTIONAL{?s rdfs:label ?sLabel}\n    MINUS {?s a crm:E67}\n    }",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "prefix sdh:<https://sdhss.org/ontology/core/>\nprefix crm: <http://www.cidoc-crm.org/cidoc-crm/>\n\nselect\t?class ?classLabel (count(*) as ?num) \n where {\n    ?s a crm:E21;\n        ?p ?o.\n    ?s1\t?p1 ?s ;\n         a ?class.\n    OPTIONAL{?class rdfs:label ?classLabel}         \n    minus{?s ?p crm:E21}\n}\ngroup by ?class ?classLabel\nlimit 10",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "prefix sdh:<https://sdhss.org/ontology/core/>\nprefix crm: <http://www.cidoc-crm.org/cidoc-crm/>\n\nselect\t?s ?p ?o\n where {\n    ?s a crm:E67;\n        ?p ?o.\n}\norder by ?s ?p\nlimit 10",
